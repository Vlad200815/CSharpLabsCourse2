<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NBUExchangeApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:NBUExchangeApp.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NBUExchangeApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NBUExchangeApp">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        
        
        <!-- Starting text -->
        <TextBlock Grid.Row="0" Text="Курс валют НБУ" FontSize="24" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="Джерело: bank.gov.ua (NBU Stat Service)" Opacity="0.7" />
        
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
            <!-- Button (load data using api) -->
            <Button Content="Завантажити з інтернету" Command="{Binding LoadCommand}" />
            <!-- Button (save data from api to local storage) -->
            <Button Content="Зберегти" Command="{Binding SaveCommand}" />
            <!-- Button (open data from local storage) -->
            <Button Content="Завантажити зі збережених" Command="{Binding  OpenCommand}" />
        </StackPanel>
        
        <!-- Spinner -->
        <Arc Grid.Row="3" Width="32" Height="32"
             StartAngle="0" SweepAngle="270"
             Stroke="DodgerBlue" StrokeThickness="4" StrokeLineCap="Round"
             HorizontalAlignment="Center"
             IsVisible="{Binding IsBusy}">
            <Arc.Styles>
                <Style Selector="Arc">
                    <Style.Animations>
                        <Animation Duration="0:0:1" IterationCount="Infinite">
                            <KeyFrame Cue="0%">
                                <Setter Property="RotateTransform.Angle" Value="0" />
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="RotateTransform.Angle" Value="360" />
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Arc.Styles>
        </Arc>
        
        <!-- Form -->
        <ListBox Grid.Row="3"
                 CornerRadius="12"
                 BorderThickness="0.5"
                 BorderBrush="Gray"
                 Padding="6"
                 ItemsSource="{Binding Readings}"
                 IsVisible="{Binding Readings, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ExchangeReading">
                    <Grid ColumnDefinitions="60,*,180,100" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="{Binding Currency}" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Rate, StringFormat={}{0:F4} UAH за 1 од.}" />
                        <TextBlock Grid.Column="3" Text="{Binding ExchangeDate}" Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- Status text -->
        <TextBlock Grid.Row="4" Text="{Binding Status}" FontStyle="Italic" />
    </Grid>
    

</Window>
